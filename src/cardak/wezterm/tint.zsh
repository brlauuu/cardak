# cardak: generated by `cardak themes zsh`; reinstalling overwrites this file.
# Per-pane background tint by project. Source it from ~/.zshrc:  source <this file>
[[ $TERM_PROGRAM == WezTerm ]] || return 0

typeset -g _cardak_tints_file=${XDG_CONFIG_HOME:-$HOME/.config}/cardak/tints

_cardak_tint() {
  # chpwd also fires in subshells (`x=$(cd dir; …)`); the sequence must not land in their output.
  (( ZSH_SUBSHELL )) && return 0
  local dir color best="" best_len=0
  if [[ -r $_cardak_tints_file ]]; then
    while IFS=$'\t' read -r dir color; do
      [[ -z $dir || $dir == '#'* ]] && continue
      if [[ $PWD == "$dir" || $PWD == "$dir"/* ]] && (( ${#dir} > best_len )); then
        best=$color
        best_len=${#dir}
      fi
    done < $_cardak_tints_file
  fi
  if [[ -n $best ]]; then
    printf '\e]11;%s\a' "$best"
  else
    printf '\e]111\a'
  fi
}

autoload -Uz add-zsh-hook
add-zsh-hook chpwd _cardak_tint
_cardak_tint
